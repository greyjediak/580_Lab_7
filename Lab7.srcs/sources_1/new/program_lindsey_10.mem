// PC: assembly          binary                               expected after writeback
C1 // 00 LDI R0,#1       110 00 001                           R0=01
CA // 01 LDI R1,#2       110 01 010                           R1=02
D5 // 02 LDI R2,#5       110 10 101                           R2=05
DE // 03 LDI R3,#6       110 11 110                           R3=06
32 // 04 SUB R2,R1       001 10 01 0   5 - 2 = 3              R2=03
08 // 05 ADD R1,R0       000 01 00 0   2 + 1 = 3              R1=03
56 // 06 AND R2,R3       010 10 11 0   0011 & 0110 = 0010     R2=02
66 // 07 IOR R0,R3       011 00 11 0   0001 | 0110 = 0111     R0=07
14 // 08 ADD R2,R2       000 10 10 0   2 + 2 = 4 (rd = rs)    R2=04
E0 // 09 HALT                                                 PC=09
E0 // 10
E0 // 11
E0 // 12
E0 // 13
E0 // 14
E0 // 15
